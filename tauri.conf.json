{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stock Operator",
  "version": "0.2.12",
  "identifier": "com.cloudiful.stock-operator",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "bun run --cwd ui build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stock Operator",
        "width": 1120,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* https://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "26.0"
    },
    "resources": []
  },
  "plugins": {}
}
